{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    // 前后端共用的类型已抽成 @unistablegen/type 本地包（../type/package.json），
    // 依赖写在 dependencies（link:../type），pnpm install 后链到 node_modules。
    // 它经 node_modules 解析进来，TS 会把它当 external library，
    // 既不会被 emit，也不参与 rootDir 归属检查（TS6059）。
    // 所以这里把 rootDir 钉死在 src：产物是 dist/index.js + dist/api/...
    "rootDir": "src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true
  },
  // 只编译 server 自己的源码；共享类型走 @unistablegen/type 包，不再进本项目的 program
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
