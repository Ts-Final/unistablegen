{
  "name": "server",
  "version": "1.0.0",
  "description": "Express.js API with TypeScript",
  "type": "module",
  "main": "dist/server/src/index.js",
  "bin": "dist/server/src/index.js",
  "pkg": {
    "targets": [
      "node24-win-x64"
    ],
    "sea": true
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "build:page": "pnpm --dir ../frontend build",
    "build:bundle": "node scripts/bundle.mjs",
    "build:icon": "node scripts/set-icon.mjs",
    "build:exe": "pnpm run build:page && pnpm run type-check && pnpm run build:bundle && pkg dist-bundle/index.js --sea --targets node24-win-x64 --output ../build/unistablegen.exe && pnpm run build:icon",
    "type-check": "tsc --noEmit",
    "start": "node dist/server/src/index.js",
    "install:ci": "npm ci"
  },
  "keywords": [
    "express",
    "typescript",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@types/ws": "^8.18.1",
    "express": "^5.0.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@yao-pkg/pkg": "^6.22.0",
    "esbuild": "^0.28.2",
    "resedit": "^3.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
